<mxfile host="app.diagrams.net" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="convoysync-sequence" name="4. UML Sequence Diagram">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="seq_0" />
        <mxCell id="seq_1" parent="seq_0" />

        <!-- Title -->
        <mxCell id="seq_title" value="ConvoySync — Comprehensive UML Sequence Diagram (Authentication, Telemetry Ingestion, Location Polling &amp; SOS Alerts)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="seq_1">
          <mxGeometry x="150" y="20" width="1300" height="40" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll_driver" value="Traveler / Driver&#xa;(User)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1F5F9;strokeColor=#475569;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="80" y="80" width="120" height="1220" as="geometry" />
        </mxCell>

        <mxCell id="ll_client" value="React Frontend&#xa;(ConvoyMap / PWA)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E0E7FF;strokeColor=#4338CA;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="270" y="80" width="140" height="1220" as="geometry" />
        </mxCell>

        <mxCell id="ll_api" value="FastAPI Backend&#xa;(Router / Middleware)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#DCFCE7;strokeColor=#15803D;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="490" y="80" width="140" height="1220" as="geometry" />
        </mxCell>

        <mxCell id="ll_auth" value="Auth Dependency&#xa;(get_current_user)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FEF3C7;strokeColor=#B45309;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="710" y="80" width="130" height="1220" as="geometry" />
        </mxCell>

        <mxCell id="ll_gis" value="GIS Engine&#xa;(Haversine &amp; Throttling)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F3E8FF;strokeColor=#7E22CE;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="920" y="80" width="150" height="1220" as="geometry" />
        </mxCell>

        <mxCell id="ll_db" value="PostgreSQL DB&#xa;(Neon Cloud / SQLAlchemy)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#CCFBF1;strokeColor=#0F766E;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="1150" y="80" width="170" height="1220" as="geometry" />
        </mxCell>

        <mxCell id="ll_convoy" value="Convoy Members&#xa;(Other Drivers)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFE4E6;strokeColor=#E11D48;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="1390" y="80" width="130" height="1220" as="geometry" />
        </mxCell>

        <!-- ============================================================= -->
        <!-- PHASE 1: GPS ADAPTIVE CAPTURE & TELEMETRY INGESTION           -->
        <!-- ============================================================= -->
        <mxCell id="frame_ingest" value="PHASE 1: VELOCITY-ADAPTIVE GPS INGESTION (Every 5s highway / 15s city / 30s stop)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=480;height=22;fillColor=none;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="60" y="150" width="1480" height="340" as="geometry" />
        </mxCell>

        <mxCell id="p1_1" value="1. GPS sensor ping (lat, lon, speed, heading)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="190" as="sourcePoint" />
            <mxPoint x="340" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_2" value="2. Calculate adaptive polling interval (e.g. speed &gt; 40 km/h -&gt; 5s)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#7E22CE;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="215" as="sourcePoint" />
            <mxPoint x="995" y="215" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_3" value="3. Return adaptive schedule interval" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#7E22CE;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="995" y="240" as="sourcePoint" />
            <mxPoint x="340" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_4" value="4. POST /trips/{id}/telemetry (lat, lon, speed, heading, is_ghost_mode) [Bearer Token]" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="270" as="sourcePoint" />
            <mxPoint x="560" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_5" value="5. Verify JWT &amp; extract current_user" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B45309;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="295" as="sourcePoint" />
            <mxPoint x="775" y="295" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_6" value="6. Return User object (id, email)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#B45309;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="775" y="320" as="sourcePoint" />
            <mxPoint x="560" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_7" value="7. Query trip_members (SELECT 1 WHERE trip_id = ? AND user_id = ?)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0F766E;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="350" as="sourcePoint" />
            <mxPoint x="1235" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="alt_membership" value="alt: Membership check" style="shape=umlFrame;whiteSpace=wrap;html=1;width=140;height=18;fillColor=none;strokeColor=#DC2626;" vertex="1" parent="seq_1">
          <mxGeometry x="320" y="370" width="940" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p1_8a" value="[Not Member] HTTP 403 Forbidden ('Must be active trip member')" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#DC2626;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="405" as="sourcePoint" />
            <mxPoint x="340" y="405" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_8b" value="[Member Verified] INSERT INTO convoy_telemetry VALUES (...) ; COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0F766E;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="440" as="sourcePoint" />
            <mxPoint x="1235" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p1_9" value="HTTP 201 Created (ping record, coords masked if is_ghost_mode)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#15803D;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="470" as="sourcePoint" />
            <mxPoint x="340" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================================= -->
        <!-- PHASE 2: CONVOY LATEST LOCATIONS POLLING & LAG EVALUATION      -->
        <!-- ============================================================= -->
        <mxCell id="frame_poll" value="PHASE 2: CONVOY POLLING &amp; DISTANCE LAG MONITORING (Periodic GET loop)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=450;height=22;fillColor=none;strokeColor=#0D9488;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="60" y="520" width="1480" height="380" as="geometry" />
        </mxCell>

        <mxCell id="p2_1" value="8. GET /trips/{id}/convoy/locations [Bearer Token]" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#1E293B;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="560" as="sourcePoint" />
            <mxPoint x="560" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_2" value="9. Authorize membership &amp; execute B-tree index scan: ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY recorded_at DESC)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0F766E;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="590" as="sourcePoint" />
            <mxPoint x="1235" y="590" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_3" value="10. Return enrolled members list + latest telemetry record for each" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#0F766E;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1235" y="620" as="sourcePoint" />
            <mxPoint x="560" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_4" value="11. Classify Freshness: &lt;=60s: 'fresh' | 60s-300s: 'stale' | &gt;300s or null: 'unavailable'" style="html=1;verticalAlign=bottom;endArrow=none;rounded=0;strokeColor=#475569;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="650" as="sourcePoint" />
            <mxPoint x="600" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_5" value="12. Privacy filter: if is_ghost_mode == True -&gt; status='hidden', latitude=null, longitude=null" style="html=1;verticalAlign=bottom;endArrow=none;rounded=0;strokeColor=#DC2626;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="685" as="sourcePoint" />
            <mxPoint x="600" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_6" value="13. HTTP 200 OK: [{user_id, name, latitude, longitude, speed_kmh, location_status, is_ghost_mode}, ...]" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#15803D;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="720" as="sourcePoint" />
            <mxPoint x="340" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_7" value="14. Forward member positions to GIS Engine" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#7E22CE;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="750" as="sourcePoint" />
            <mxPoint x="995" y="750" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_8" value="15. Compute Convoy Centroid &amp; Haversine distance; Check lag &gt; 2.0 km threshold" style="html=1;verticalAlign=bottom;endArrow=none;rounded=0;strokeColor=#7E22CE;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="995" y="775" as="sourcePoint" />
            <mxPoint x="1035" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_9" value="16. Return lag evaluation: {has_lag: true/false, lagging_members: [...] }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#7E22CE;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="995" y="810" as="sourcePoint" />
            <mxPoint x="340" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_10" value="17. Render Leaflet Map: car pins (green/amber/gray), tooltips, and Amber Lag Warning banner" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#4338CA;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="845" as="sourcePoint" />
            <mxPoint x="140" y="845" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p2_11" value="18. Lag alert rendered on other convoy member screens via their polling cycle" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;dashed=1;strokeColor=#E11D48;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="875" as="sourcePoint" />
            <mxPoint x="1455" y="875" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================================= -->
        <!-- PHASE 3: EMERGENCY SOS SIREN TRIGGER & OFFLINE SMS             -->
        <!-- ============================================================= -->
        <mxCell id="frame_sos" value="PHASE 3: EMERGENCY SOS SIREN WITH 5s COUNTDOWN &amp; SMS FALLBACK" style="shape=umlFrame;whiteSpace=wrap;html=1;width=420;height=22;fillColor=none;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="seq_1">
          <mxGeometry x="60" y="930" width="1480" height="340" as="geometry" />
        </mxCell>

        <mxCell id="p3_1" value="19. Driver taps One-Touch SOS Button" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#DC2626;fontStyle=1;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="970" as="sourcePoint" />
            <mxPoint x="340" y="970" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p3_2" value="20. Initiate 5-second abort countdown with audio warning" style="html=1;verticalAlign=bottom;endArrow=none;rounded=0;strokeColor=#DC2626;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="995" as="sourcePoint" />
            <mxPoint x="380" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="alt_sos" value="alt: 5s Countdown Result" style="shape=umlFrame;whiteSpace=wrap;html=1;width=160;height=18;fillColor=none;strokeColor=#B45309;" vertex="1" parent="seq_1">
          <mxGeometry x="120" y="1020" width="1380" height="230" as="geometry" />
        </mxCell>

        <mxCell id="p3_3a" value="[Cancelled within 5s] Driver taps 'Cancel' -&gt; Abort broadcast, record false alarm state" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#64748B;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="1055" as="sourcePoint" />
            <mxPoint x="340" y="1055" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p3_3b" value="[Timer Expires] POST /trips/{id}/sos (lat, lon, alert_type='sos_siren')" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#DC2626;fontStyle=1;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="1090" as="sourcePoint" />
            <mxPoint x="560" y="1090" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p3_4" value="21. INSERT INTO emergency_alerts (trip_id, user_id, status='active', ...) ; COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#0F766E;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="1120" as="sourcePoint" />
            <mxPoint x="1235" y="1120" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p3_5" value="22. Generate offline SMS fallback link: sms:+91...?body=EMERGENCY_GPS_LAT_LON" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#B45309;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="1155" as="sourcePoint" />
            <mxPoint x="140" y="1155" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="p3_6" value="23. High-priority distress siren &amp; flashing red banner broadcast to all convoy members" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#DC2626;fontStyle=1;" edge="1" parent="seq_1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="1195" as="sourcePoint" />
            <mxPoint x="1455" y="1195" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
