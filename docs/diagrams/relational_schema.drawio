        </mxCell>

        
        <mxCell id="tbl_users" value="users&#10;---------------------------------------&#10;PK  id : INTEGER&#10;    name : VARCHAR(100)&#10;    email : VARCHAR(255) [UQ]&#10;    password_hash : VARCHAR(255) [NULLABLE Sprint 6]&#10;    firebase_uid : VARCHAR(128) [UQ, NULLABLE]&#10;    phone_number : VARCHAR(20) [NULLABLE]&#10;    created_at : TIMESTAMP WITH TIME ZONE&#10;    updated_at : TIMESTAMP WITH TIME ZONE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#E0E7FF;strokeColor=#4338CA;fontColor=#1E1B4B;fontSize=12;" vertex="1" parent="rel_1">
          <mxGeometry x="80" y="100" width="250" height="205" as="geometry" />
        </mxCell>

        
        <mxCell id="tbl_trips" value="trips&#10;---------------------------------------&#10;PK  id : INTEGER&#10;    title : VARCHAR(200)&#10;    description : TEXT [NULLABLE]&#10;    destination : VARCHAR(200)&#10;    start_date : DATE&#10;    end_date : DATE&#10;FK  host_id : INTEGER -&gt; users.id [ON DELETE CASCADE]&#10;    trip_code : VARCHAR(8) [UQ]&#10;    created_at : TIMESTAMP WITH TIME ZONE&#10;    updated_at : TIMESTAMP WITH TIME ZONE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#14532D;fontSize=12;" vertex="1" parent="rel_1">
          <mxGeometry x="460" y="100" width="260" height="220" as="geometry" />
        </mxCell>

        
        <mxCell id="tbl_trip_members" value="trip_members&#10;---------------------------------------&#10;PK  id : INTEGER&#10;FK  trip_id : INTEGER -&gt; trips.id [CASCADE]&#10;FK  user_id : INTEGER -&gt; users.id [CASCADE]&#10;    role : VARCHAR(20) [host | member]&#10;    joined_at : TIMESTAMP WITH TIME ZONE&#10;[UQ: (trip_id, user_id)]" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;fontSize=12;" vertex="1" parent="rel_1">
