        </mxCell>

        
        <mxCell id="tbl_expenses" value="expenses&#10;---------------------------------------&#10;PK  id : INTEGER&#10;FK  trip_id : INTEGER -&gt; trips.id [CASCADE]&#10;FK  payer_id : INTEGER -&gt; users.id [CASCADE]&#10;    title : VARCHAR(200)&#10;    amount : NUMERIC(10,2)&#10;    currency : VARCHAR(3) [DEFAULT 'USD']&#10;    category : VARCHAR(50)&#10;    description : TEXT [NULLABLE]&#10;    status : VARCHAR(30) [pending | accepted | disputed]&#10;    created_at : TIMESTAMP WITH TIME ZONE&#10;    updated_at : TIMESTAMP WITH TIME ZONE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FCE7F3;strokeColor=#BE185D;fontColor=#831843;fontSize=12;" vertex="1" parent="rel_1">
