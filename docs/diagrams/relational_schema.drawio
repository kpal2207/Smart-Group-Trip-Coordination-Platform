        <mxCell id="tbl_sos" value="emergency_alerts (Sprint 4)&#10;---------------------------------------&#10;PK  id : INTEGER&#10;FK  trip_id : INTEGER -&gt; trips.id [CASCADE]&#10;FK  user_id : INTEGER -&gt; users.id [CASCADE]&#10;    latitude : DECIMAL(10,8)&#10;    longitude : DECIMAL(11,8)&#10;    status : VARCHAR(20) [active | resolved | false_alarm]&#10;    alert_type : VARCHAR(50) [sos_siren | medical | ...]&#10;    notes : TEXT [NULLABLE]&#10;    created_at : TIMESTAMP WITH TIME ZONE&#10;    resolved_at : TIMESTAMP WITH TIME ZONE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;" vertex="1" parent="rel_1">
