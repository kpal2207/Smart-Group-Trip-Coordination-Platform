        <mxCell id="tbl_notifications" value="notifications&#10;---------------------------------------&#10;PK  id : INTEGER&#10;FK  user_id : INTEGER -&gt; users.id [CASCADE]&#10;FK  trip_id : INTEGER -&gt; trips.id [CASCADE]&#10;FK  expense_id : INT -&gt; expenses.id [SET NULL]&#10;    message : TEXT&#10;    notification_type : VARCHAR(50)&#10;    is_read : BOOLEAN [DEFAULT FALSE]&#10;    created_at : TIMESTAMP WITH TIME ZONE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#0F172A;fontSize=12;" vertex="1" parent="rel_1">
