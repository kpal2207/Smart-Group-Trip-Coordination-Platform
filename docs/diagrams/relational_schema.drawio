        </mxCell>

        
        <mxCell id="tbl_telemetry" value="convoy_telemetry (Sprint 2)&#10;---------------------------------------&#10;PK  id : BIGSERIAL / BIGINT&#10;FK  trip_id : INTEGER -&gt; trips.id [CASCADE]&#10;FK  user_id : INTEGER -&gt; users.id [CASCADE]&#10;    latitude : DECIMAL(10,8) [CHECK -90 to 90]&#10;    longitude : DECIMAL(11,8) [CHECK -180 to 180]&#10;    speed_kmh : DECIMAL(5,2) [CHECK &gt;= 0]&#10;    heading : DECIMAL(5,2) [CHECK 0 to 360, NULL]&#10;    is_ghost_mode : BOOLEAN [DEFAULT FALSE]&#10;    recorded_at : TIMESTAMP WITH TIME ZONE&#10;[INDEX: (trip_id, user_id, recorded_at DESC)]" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;fontSize=12;" vertex="1" parent="rel_1">
