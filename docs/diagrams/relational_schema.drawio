        <mxCell id="tbl_expense_splits" value="expense_splits&#10;---------------------------------------&#10;PK  id : INTEGER&#10;FK  expense_id : INTEGER -&gt; expenses.id [CASCADE]&#10;FK  user_id : INTEGER -&gt; users.id [CASCADE]&#10;    share_amount : NUMERIC(10,2)&#10;    is_accepted : BOOLEAN [DEFAULT FALSE]&#10;    created_at : TIMESTAMP WITH TIME ZONE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#581C87;fontSize=12;" vertex="1" parent="rel_1">
