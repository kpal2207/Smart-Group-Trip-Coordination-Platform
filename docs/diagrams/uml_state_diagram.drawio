        <mxCell id="tr_sos1" edge="1" parent="grp_sos_st" source="st_sos_init" target="st_sos_countdown"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_sos2" value="Timer expires" edge="1" parent="grp_sos_st" source="st_sos_countdown" target="st_sos_active"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_sos3" value="Cancelled in &lt;5s" edge="1" parent="grp_sos_st" source="st_sos_countdown" target="st_sos_false"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_sos4" value="Host/User clears" edge="1" parent="grp_sos_st" source="st_sos_active" target="st_sos_resolved"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_sos5" edge="1" parent="grp_sos_st" source="st_sos_resolved" target="st_sos_end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_sos6" edge="1" parent="grp_sos_st" source="st_sos_false" target="st_sos_end"><mxGeometry relative="1" as="geometry" /></mxCell>

