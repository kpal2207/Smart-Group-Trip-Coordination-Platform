        <mxCell id="grp_settle" value="2. Trip Settlement Lifecycle (TripSettlementStatus)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;startSize=26;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;" vertex="1" parent="st_1">
          <mxGeometry x="540" y="80" width="420" height="340" as="geometry" />
