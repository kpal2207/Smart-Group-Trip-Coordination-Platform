        <mxCell id="grp_dispute" value="1. Expense Dispute Lifecycle (DisputeStatus)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;startSize=26;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#881337;" vertex="1" parent="st_1">
