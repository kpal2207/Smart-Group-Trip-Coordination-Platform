        </mxCell>

        <mxCell id="st_disp_keep" value="Resolved:&#10;Keep Split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontStyle=1;" vertex="1" parent="grp_dispute">
          <mxGeometry x="270" y="40" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="st_disp_modify" value="Resolved:&#10;Modify Split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontStyle=1;" vertex="1" parent="grp_dispute">
          <mxGeometry x="100" y="160" width="110" height="50" as="geometry" />
