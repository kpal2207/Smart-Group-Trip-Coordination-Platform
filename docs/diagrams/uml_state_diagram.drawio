        </mxCell>

        <mxCell id="st_sos_false" value="False Alarm&#10;(Aborted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontStyle=1;" vertex="1" parent="grp_sos_st">
          <mxGeometry x="90" y="160" width="100" height="40" as="geometry" />
