        <mxCell id="st_disp_end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#E11D48;" vertex="1" parent="grp_dispute">
          <mxGeometry x="320" y="175" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="tr_d1" edge="1" parent="grp_dispute" source="st_disp_init" target="st_disp_pending"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_d2" value="Host rejects dispute" edge="1" parent="grp_dispute" source="st_disp_pending" target="st_disp_keep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_d3" value="Host upholds &amp; adjusts" edge="1" parent="grp_dispute" source="st_disp_pending" target="st_disp_modify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tr_d4" edge="1" parent="grp_dispute" source="st_disp_keep" target="st_disp_end"><mxGeometry relative="1" as="geometry" /></mxCell>
