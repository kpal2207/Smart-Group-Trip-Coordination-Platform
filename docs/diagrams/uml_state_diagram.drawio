        </mxCell>

        <mxCell id="st_set_settled" value="Settled Trip&#10;(All Balances Zero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontStyle=1;" vertex="1" parent="grp_settle">
          <mxGeometry x="270" y="50" width="130" height="40" as="geometry" />
