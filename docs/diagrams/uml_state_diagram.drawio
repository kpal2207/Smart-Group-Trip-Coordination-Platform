        <mxCell id="st_disp_pending" value="Pending&#10;Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#E11D48;fontStyle=1;" vertex="1" parent="grp_dispute">
