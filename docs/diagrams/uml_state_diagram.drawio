        <mxCell id="tr_s4" edge="1" parent="grp_settle" source="st_set_settled" target="st_set_end"><mxGeometry relative="1" as="geometry" /></mxCell>

        
        <mxCell id="grp_sos_st" value="3. Emergency SOS Alert Lifecycle (EmergencyAlert)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;startSize=26;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;" vertex="1" parent="st_1">
