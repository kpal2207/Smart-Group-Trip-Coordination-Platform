        </mxCell>

        <mxCell id="st_sos_countdown" value="5s Abort&#10;Countdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;" vertex="1" parent="grp_sos_st">
