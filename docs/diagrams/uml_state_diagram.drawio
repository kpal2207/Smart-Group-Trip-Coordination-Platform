        <mxCell id="st_sos_active" value="Active Siren&#10;Broadcast" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#991B1B;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="grp_sos_st">
