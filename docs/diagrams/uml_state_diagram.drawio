          <mxGeometry x="30" y="60" width="20" height="20" as="geometry" />
        </mxCell>

        <mxCell id="st_set_active" value="Active Trip&#10;(Ongoing Expenses)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontStyle=1;" vertex="1" parent="grp_settle">
