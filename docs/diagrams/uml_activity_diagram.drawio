        <mxCell id="act_enroll" value="Create trip_members record&#10;(role = 'member')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#15803D;fontStyle=1;" vertex="1" parent="act_1">
