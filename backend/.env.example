# Backend environment variables
# Copy this file to .env and replace the development values as needed.
# Never commit .env to Git.

# Database (use localhost when running the backend outside Docker)
DATABASE_DIALECT=postgresql
DATABASE_USER=tripuser
DATABASE_PASSWORD=trippass
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tripmanager

# Authentication / JWT signing
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend origin allowed by the backend
FRONTEND_URL=http://localhost:5173
