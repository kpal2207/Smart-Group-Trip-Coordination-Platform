# Docker development settings.
# Copy this file to .env.docker and update with your Supabase credentials.

# Supabase PostgreSQL Database Settings
DATABASE_DIALECT=postgresql
DATABASE_USER=postgres.<your-project-ref>
DATABASE_PASSWORD=<your-db-password>
DATABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres

# Supabase Auth
SUPABASE_URL=https://<your-project-ref>.supabase.co
SECRET_KEY=local-development-fallback-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
