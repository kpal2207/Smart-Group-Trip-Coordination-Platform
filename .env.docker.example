# Docker database settings. "db" is the Compose service hostname.
# Copy to .env.docker and replace these development-only values as needed.
# Never use these credentials in production.
DATABASE_DIALECT=postgresql
DATABASE_USER=tripuser
DATABASE_PASSWORD=trippass
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=tripmanager

# PostgreSQL container initialization
POSTGRES_DB=tripmanager
POSTGRES_USER=tripuser
POSTGRES_PASSWORD=trippass

# Authentication
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
